# Cadena de conexión de Neon (en Vercel usá la versión "pooled", con -pooler en el host)
DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require

# Texto largo y aleatorio para firmar las sesiones
JWT_SECRET=cambiame-por-un-texto-largo-y-aleatorio

# Opcional: máximo de conexiones del pool por instancia (por defecto 5)
# PG_POOL_MAX=5

# Avisos al celular (notificaciones push). Opcional: sin estas claves la app funciona igual, sin avisos.
# Generarlas UNA vez con `npm run vapid` y cargarlas en Vercel (Settings → Environment Variables).
# La clave privada es secreta: nunca la subas al repo.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://magistro.vercel.app
